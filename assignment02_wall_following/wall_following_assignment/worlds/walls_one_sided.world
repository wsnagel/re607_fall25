    <include>
  <uri>model://Grey Wall</uri>
</include>
<pose relative_to=''>19.4503 6.28584 0 0 -0 0.62</pose>
</model>

<model name="grey_wall_3">
    <include>
  <uri>model://Grey Wall</uri>
</include>
<pose relative_to=''>18 16.5 0 0 -0 -0.2</pose>
</model>

<model name="grey_wall_4">
    <include>
  <uri>model://Grey Wall</uri>
</include>
<pose relative_to=''>22 12.2 0 0 -0 1.7</pose>
</model>

<model name="grey_wall_5">
    <include>
  <uri>model://Grey Wall</uri>
</include>
<pose relative_to=''>13.7248 16.882 0 0 -0 0</pose>
</model>

<model name="grey_wall_6">
    <include>
  <uri>model://Grey Wall</uri>
</include>
<pose relative_to=''>6.26537 16.8814 0 0 -0 0</pose>
</model>

